/hda_mocker_4.exe

# Scenario dataset payloads are local; only configs and directory placeholders
# are tracked. Each preset owns its hda/, da/ and runtime/.
/presets/*/hda/*
!/presets/*/hda/.gitkeep
/presets/*/da/*
!/presets/*/da/.gitkeep
/presets/*/runtime/
!/presets/*/runtime/.gitkeep

# Orphaned root-level payload left over from the pre-scenario layout.
/runtime/
/archive/

# Frontend dependencies are reproducible from package-lock.json. The built
# dist directory is intentionally tracked because Go embeds it into the exe.
/frontend/node_modules/
/build/
/build_test_gui.exe
